# Database URL (Postgres in production, SQLite in local dev)
# Railway/Render automatically provide this when provisioning Postgres
DATABASE_URL=postgresql+asyncpg://watchlist:watchlist@localhost:5432/watchlist

# Redis URL (Real Redis in production, memory:// in zero-dependency local dev)
# Railway/Render automatically provide this when provisioning Redis
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins (comma-separated list or JSON array)
# Add your deployed Vercel domain here (e.g. https://my-watchlist.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Simulator Configuration
TICK_INTERVAL_SECONDS=2.0
ROLLING_WINDOW_SIZE=20
STALE_TICK_PROBABILITY=0.05

# Statistical Anomaly Detection Thresholds
Z_NOTABLE_THRESHOLD=1.5
Z_MEANINGFUL_THRESHOLD=2.5
FLAT_PERCENT_THRESHOLD=0.03
