# ─── Local Development ───
# Override the Vite dev-server proxy target (defaults to http://localhost:8000)
# VITE_DEV_BACKEND_URL=http://localhost:8000

# ─── Production / Deployment ───
# Set these as environment variables in your hosting provider (Vercel, Netlify, etc.)
# When the frontend is served from the same origin as the backend (e.g. Docker),
# these are NOT needed — the client auto-detects the origin.

# Explicit backend HTTP API base URL (only needed if frontend and backend are on different domains)
# VITE_API_URL=https://your-backend.onrender.com/api

# Explicit WebSocket URL (only needed if frontend and backend are on different domains)
# VITE_WS_URL=wss://your-backend.onrender.com
